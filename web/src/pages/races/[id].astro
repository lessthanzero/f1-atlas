---
import Base from '../../layouts/Base.astro';
import GridFinishChart from '../../components/GridFinishChart.astro';
import ReliabilityStrip from '../../components/ReliabilityStrip.astro';
import { listRaceIds, getRace, hrefFor } from '../../lib/data';
import { abbrevName, outcomeFromResult } from '../../lib/viz';

export function getStaticPaths() {
  return listRaceIds().map((id) => ({ params: { id: String(id) } }));
}

const race = getRace(Number(Astro.params.id));

const gridFinishRows = race.results.map((r: any) => ({
  label: abbrevName(r.driverName),
  href: hrefFor('driver', r.driverId),
  grid: r.grid ?? null,
  finish: r.pos ?? null,
  gained: r.gained ?? null,
}));

const reliabilityCells = [...race.results]
  .sort((a: any, b: any) => (a.grid ?? 99) - (b.grid ?? 99))
  .map((r: any) => ({
    outcome: outcomeFromResult(r),
    title: `${r.driverName}: grid ${r.grid ?? '—'} → ${r.posText ?? '—'}${r.retired ? ` (${r.retired})` : ''}`,
  }));
---
<Base title={`${race.name} · F1 Atlas`}>
  <p class="meta">RACE · {race.year} R{race.round}</p>
  <h1>{race.name}</h1>
  <p class="meta">
    {race.date ?? '—'} ·
    {race.circuitId ? (
      <a href={hrefFor('circuit', race.circuitId)}>{race.circuitName}</a>
    ) : '—'}
    · <a href={hrefFor('season', String(race.year))}>{race.year}</a>
  </p>

  {race.results?.length > 0 && (
    <>
      <h2>Grid → finish</h2>
      <GridFinishChart
        rows={gridFinishRows}
        width={400}
        height={Math.min(420, 24 + race.results.filter((r: any) => r.grid && r.pos).length * 14)}
        title="Classified runners only"
      />

      <h2>Field reliability</h2>
      <ReliabilityStrip
        cells={reliabilityCells}
        max={40}
        newestFirst={false}
        caption="Ordered by grid · each cell is one starter"
      />
    </>
  )}

  <h2>Race results</h2>
  <table class="table sticky">
    <thead>
      <tr><th>#</th><th>Driver</th><th>Team</th><th>Grid</th><th>+/−</th><th>Laps</th><th>Time / note</th><th>Pts</th></tr>
    </thead>
    <tbody>
      {race.results.map((r: any) => (
        <tr class={r.retired || (r.posText || '').toUpperCase() === 'DNF' ? 'dnf' : undefined}>
          <td>{r.posText ?? '—'}</td>
          <td><a href={hrefFor('driver', r.driverId)}>{r.driverName}</a></td>
          <td>
            {r.constructorId ? (
              <a href={hrefFor('constructor', r.constructorId)}>{r.constructorName}</a>
            ) : '—'}
          </td>
          <td>{r.grid ?? '—'}</td>
          <td class:list={[
            typeof r.gained === 'number' && r.gained > 0 && 'gain',
            typeof r.gained === 'number' && r.gained < 0 && 'loss',
          ]}>
            {typeof r.gained === 'number' ? (r.gained > 0 ? `+${r.gained}` : r.gained) : '—'}
          </td>
          <td>{r.laps ?? '—'}</td>
          <td>{r.time ?? r.retired ?? '—'}</td>
          <td>{r.points ?? '—'}</td>
        </tr>
      ))}
    </tbody>
  </table>

  {race.qualifying?.length > 0 && (
    <>
      <h2>Qualifying</h2>
      <table class="table sticky">
        <thead><tr><th>#</th><th>Driver</th><th>Team</th><th>Time</th></tr></thead>
        <tbody>
          {race.qualifying.map((q: any) => (
            <tr>
              <td>{q.posText ?? '—'}</td>
              <td><a href={hrefFor('driver', q.driverId)}>{q.driverName}</a></td>
              <td>
                {q.constructorId ? (
                  <a href={hrefFor('constructor', q.constructorId)}>{q.constructorName}</a>
                ) : '—'}
              </td>
              <td>{q.time ?? '—'}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </>
  )}
</Base>
<style>
  h2 { font-size: 1.1rem; margin: 1.5rem 0 0.5rem; }
  .sticky thead th { position: sticky; top: 0; background: var(--paper); }
  a { text-decoration: none; }
  .gain { color: #1a7a4c; font-family: var(--mono); }
  .loss { color: var(--accent); font-family: var(--mono); }
  tr.dnf td { color: var(--muted); }
</style>
