---
import Base from '../../layouts/Base.astro';
import Country from '../../components/Country.astro';
import ConstructorMark from '../../components/ConstructorMark.astro';
import { getConstructors, hrefFor } from '../../lib/data';
const constructors = getConstructors();
---
<Base title="Teams · F1 Atlas">
  <p class="meta">CONSTRUCTORS · {constructors.length}</p>
  <h1>Teams</h1>
  <table class="table sticky">
    <thead>
      <tr><th>Team</th><th>Country</th><th>Wins</th><th>Podiums</th><th>Poles</th><th>Titles</th><th>Starts</th></tr>
    </thead>
    <tbody>
      {constructors.map((c) => (
        <tr>
          <td>
            <a class="team-link" href={hrefFor('constructor', c.id)}>
              <ConstructorMark id={c.id} name={c.name} size="sm" />
              <span>{c.name}</span>
            </a>
          </td>
          <td>
            <Country
              countryName={c.countryName}
              countryCode={c.countryCode}
              countryId={c.countryId}
            />
          </td>
          <td>{c.wins}</td>
          <td>{c.podiums}</td>
          <td>{c.poles}</td>
          <td>{c.titles}</td>
          <td>{c.starts}</td>
        </tr>
      ))}
    </tbody>
  </table>
</Base>
<style>
  .sticky thead th { position: sticky; top: 0; background: var(--paper); }
  .team-link {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    text-decoration: none;
    font-weight: 600;
  }
</style>
