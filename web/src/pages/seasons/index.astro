---
import Base from '../../layouts/Base.astro';
import { getSeasons, hrefFor } from '../../lib/data';
const seasons = getSeasons();
---
<Base title="Seasons · F1 Atlas">
  <p class="meta">SEASONS</p>
  <h1>Seasons</h1>
  <table class="table">
    <thead><tr><th>Year</th><th></th></tr></thead>
    <tbody>
      {seasons.map((year) => (
        <tr>
          <td><a href={hrefFor('season', String(year))}>{year}</a></td>
          <td class="muted">standings & race list</td>
        </tr>
      ))}
    </tbody>
  </table>
</Base>
<style>
  .muted { color: var(--muted); font-size: 0.85rem; }
</style>
